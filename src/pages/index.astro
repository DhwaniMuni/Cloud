---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { getTopics } from '../lib/topics';
import { site } from '../data/site';
import { topicPath } from '../lib/paths';

const topics = await getTopics();

// The "Start here" callout points at one topic out of several. With a single
// topic there is nothing to point away from, so it would just repeat the list.
const featured = topics.length > 1 ? topics.find((entry) => entry.data.featured) : undefined;
---

<BaseLayout title="Overview" description={site.summary} current="overview">
  <div class="home">
    <header class="hero">
      <h1>{site.author}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-summary">{site.summary}</p>
    </header>

    <section class="topics-section" aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="section-heading">What I learned</h2>
      <ol class="topic-list">
        {
          topics.map((entry) => (
            <TopicCard
              slug={entry.id}
              order={entry.data.order}
              title={entry.data.title}
              hook={entry.data.hook}
              tools={entry.data.tools}
              draft={entry.data.draft}
            />
          ))
        }
      </ol>
    </section>

    {
      featured && (
        <section class="featured" aria-labelledby="featured-heading">
          <p class="featured-eyebrow">Start here</p>
          <h2 id="featured-heading" class="featured-title">
            <a href={topicPath(featured.id)}>{featured.data.title}</a>
          </h2>
          <p class="featured-hook">{featured.data.hook}</p>
          <p class="featured-cta">
            <a href={topicPath(featured.id)}>
              Read it
              <span aria-hidden="true"> →</span>
            </a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--gutter) 0;
  }

  /* ── Hero — compact by design; depth lives one click down. ─────────────── */

  .hero {
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--border);
  }

  .hero h1 {
    font-size: var(--text-4xl);
  }

  .hero-tagline {
    margin-top: var(--space-3xs);
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .hero-summary {
    margin-top: var(--space-md);
    max-width: var(--measure);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* ── Topic list ─────────────────────────────────────────────────────────── */

  .topics-section {
    margin-top: var(--space-xl);
  }

  .section-heading {
    margin-bottom: var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .topic-list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── Featured callout ───────────────────────────────────────────────────── */

  .featured {
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--accent-subtle);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius-lg);
  }

  .featured-eyebrow {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .featured-title {
    margin-top: var(--space-3xs);
    font-size: var(--text-2xl);
  }

  .featured-title a {
    color: var(--text);
    text-decoration: none;
  }

  .featured-title a:hover {
    color: var(--accent);
  }

  .featured-hook {
    margin-top: var(--space-2xs);
    max-width: var(--measure);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }

  .featured-cta {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .featured-cta a {
    text-decoration: none;
  }

  .featured-cta a:hover {
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .home {
      padding-top: var(--space-xl);
    }

    .hero h1 {
      font-size: var(--text-3xl);
    }

    .featured {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
