---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import WeekLayout from '../../layouts/WeekLayout.astro';
import { getWeeks, neighbours } from '../../lib/weeks';

/**
 * One page per week, at /week/<n>. The route param is the week NUMBER from
 * frontmatter, not the filename, so renaming a content file never changes a URL.
 */
export const getStaticPaths = (async () => {
  const weeks = await getWeeks();

  return weeks.map((entry) => ({
    params: { slug: String(entry.data.week) },
    props: { entry, ...neighbours(weeks, entry.data.week) },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

// `headings` covers the MDX body only; WeekLayout adds the fixed section
// headings around it. An empty body means the "What I worked on" section and
// its rail entry are dropped.
const hasBody = (entry.body ?? '').trim().length > 0;
---

<WeekLayout entry={entry} bodyHeadings={headings} prev={prev} next={next} hasBody={hasBody}>
  <Content />
</WeekLayout>
