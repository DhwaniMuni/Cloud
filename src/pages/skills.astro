---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTopics } from '../lib/topics';
import { getTool, toolSlug, TOOL_CATEGORIES, type ToolCategory } from '../data/tools';
import { topicPath } from '../lib/paths';

/**
 * Skills index — DERIVED at build time from topic frontmatter.
 *
 * Nothing here is hand-maintained: add a tool to a topic's `tools:` list and it
 * appears here automatically, linked to every topic it was used in. Registry
 * entries never referenced by a topic are deliberately omitted, so this page
 * reflects what was actually used rather than what is installed.
 */
const topics = await getTopics();

interface Usage {
  name: string;
  slug: string;
  docs?: string;
  category: ToolCategory;
  topics: { slug: string; tab: string; title: string }[];
}

const usageByTool = new Map<string, Usage>();

for (const entry of topics) {
  for (const name of entry.data.tools) {
    const use = { slug: entry.id, tab: entry.data.tab, title: entry.data.title };
    const existing = usageByTool.get(name);
    if (existing) {
      existing.topics.push(use);
      continue;
    }
    const tool = getTool(name);
    usageByTool.set(name, {
      name,
      slug: toolSlug(name),
      docs: tool?.docs,
      // The schema guarantees the tool is registered, so this is never a guess.
      category: tool!.category,
      topics: [use],
    });
  }
}

const grouped = TOOL_CATEGORIES.map((category) => ({
  category,
  tools: [...usageByTool.values()]
    .filter((usage) => usage.category === category)
    .sort((a, b) => a.name.localeCompare(b.name)),
})).filter((group) => group.tools.length > 0);

const total = usageByTool.size;
const topicCount = `${topics.length} ${topics.length === 1 ? 'topic' : 'topics'}`;
const description = `The ${total} tools and practices used across every topic on this site, grouped by category and linked to where they appeared.`;
---

<BaseLayout title="Skills" description={description} current="skills">
  <div class="skills">
    <header class="skills-header">
      <h1>Skills</h1>
      <p class="skills-intro">
        {total} tools and practices across {topicCount}. Every entry is generated from topic
        frontmatter — follow a tool through to where it was used.
      </p>
    </header>

    {
      grouped.map((group) => (
        <section class="category" aria-labelledby={`category-${group.category.toLowerCase()}`}>
          <h2 id={`category-${group.category.toLowerCase()}`} class="category-heading">
            {group.category}
            <span class="category-count">{group.tools.length}</span>
          </h2>

          <ul class="tool-list">
            {group.tools.map((tool) => (
              <li class="tool" id={tool.slug}>
                <h3 class="tool-name">
                  {tool.docs ? (
                    <a href={tool.docs} rel="noopener noreferrer">
                      {tool.name}
                    </a>
                  ) : (
                    tool.name
                  )}
                </h3>
                <ul class="tool-topics" aria-label={`Topics that used ${tool.name}`}>
                  {tool.topics.map((usage) => (
                    <li>
                      <a href={topicPath(usage.slug)} class="topic-ref" title={usage.title}>
                        {usage.tab}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .skills {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--gutter) 0;
  }

  .skills-header {
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--border);
  }

  .skills-intro {
    margin-top: var(--space-2xs);
    max-width: var(--measure);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .category {
    margin-top: var(--space-2xl);
  }

  .category-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-width) solid var(--border);
    font-size: var(--text-lg);
  }

  .category-count {
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .tool-list {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    /* Anchor targets clear the sticky tab bar. */
    scroll-margin-top: calc(var(--tabbar-height) + var(--space-md));
  }

  .tool:hover {
    background-color: var(--bg-subtle);
  }

  /* Highlight the tool a chip linked to, so arriving via #anchor is obvious. */
  .tool:target {
    background-color: var(--accent-subtle);
    border-color: var(--accent-border);
  }

  .tool-name {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-normal);
  }

  .tool-name a {
    text-decoration: none;
    color: var(--text);
  }

  .tool-name a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .tool-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-ref {
    display: inline-block;
    padding: 0.05rem var(--space-2xs);
    background-color: var(--bg-inset);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .topic-ref:hover {
    color: var(--accent);
    border-color: var(--accent-border);
  }
</style>
