---
import { path, topicPath } from '../lib/paths';
import { getTopics } from '../lib/topics';
import ThemeToggle from './ThemeToggle.astro';

/**
 * Persistent top navigation: Overview · <topic tabs…> · Skills.
 *
 * Tabs are derived from the topics collection, so adding a content file adds a
 * tab. A real <nav> wrapping a list; the active tab gets aria-current="page".
 * Horizontally scrollable on narrow screens — never wraps.
 */
interface Props {
  /** Active tab: 'overview', 'skills', or a topic slug. */
  current: 'overview' | 'skills' | (string & {});
}

const { current } = Astro.props;

const topics = await getTopics();

const tabs = [
  { href: path('/'), label: 'Overview', active: current === 'overview' },
  ...topics.map((entry) => ({
    href: topicPath(entry.id),
    label: entry.data.tab,
    active: current === entry.id,
  })),
  { href: path('skills'), label: 'Skills', active: current === 'skills' },
];
---

<header class="site-header">
  <nav class="tabbar" aria-label="Topics">
    <ul class="tabbar-list">
      {
        tabs.map((tab) => (
          <li class="tabbar-item">
            <a href={tab.href} class="tab" aria-current={tab.active ? 'page' : undefined}>
              {tab.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="header-actions">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tabbar-height);
    padding-inline: var(--gutter);
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-width) solid var(--border);
  }

  .tabbar {
    flex: 1;
    min-width: 0; /* lets the list scroll instead of pushing the toggle out */
  }

  .tabbar-list {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .tabbar-list::-webkit-scrollbar {
    display: none;
  }

  .tabbar-item {
    flex: 0 0 auto; /* no wrapping, ever */
  }

  .tab {
    display: block;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .tab:hover {
    color: var(--text);
    background-color: var(--bg-inset);
  }

  .tab[aria-current='page'] {
    color: var(--accent);
    background-color: var(--accent-subtle);
  }

  .header-actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  @media (max-width: 26rem) {
    .site-header {
      padding-inline: var(--space-2xs);
    }

    /* Bigger touch targets on phones. */
    .tab {
      padding: var(--space-2xs);
    }
  }
</style>
