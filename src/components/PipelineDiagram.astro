---
/**
 * Horizontal stepped-stage diagram for any sequential flow.
 *
 *   <PipelineDiagram
 *     caption="Commit to production"
 *     stages={[
 *       { label: 'Source', detail: 'GitHub push to main' },
 *       { label: 'Build',  detail: 'CodeBuild → Docker image' },
 *     ]}
 *   />
 *
 * Renders as an ordered list so the sequence survives without CSS, and the
 * connecting arrows are decorative-only. Wraps to a vertical layout on mobile.
 */
export interface Stage {
  label: string;
  detail?: string;
  /** Optional short glyph or emoji shown above the label. Decorative. */
  icon?: string;
}

interface Props {
  stages: Stage[];
  /** Figure caption. Also becomes the accessible name of the figure. */
  caption?: string;
  /** Accessible label when there is no visible caption. */
  ariaLabel?: string;
}

const { stages, caption, ariaLabel } = Astro.props;
const label = caption ?? ariaLabel ?? 'Pipeline stages';
---

<figure class="pipeline" aria-label={caption ? undefined : label}>
  <ol class="pipeline-track">
    {
      stages.map((stage, index) => (
        <li class="pipeline-stage">
          <div class="stage-card">
            <span class="stage-number" aria-hidden="true">
              {index + 1}
            </span>
            <div class="stage-text">
              {stage.icon && (
                <span class="stage-icon" aria-hidden="true">
                  {stage.icon}
                </span>
              )}
              <span class="stage-label">{stage.label}</span>
              {stage.detail && <span class="stage-detail">{stage.detail}</span>}
            </div>
          </div>
          {index < stages.length - 1 && (
            <span class="stage-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path
                  d="M4 12h14m0 0-4.5-4.5M18 12l-4.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          )}
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pipeline {
    margin-block: var(--space-lg);
    /* Diagrams are allowed to break the prose measure. */
    width: 100%;
  }

  .pipeline-track {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipeline-stage {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .stage-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: var(--space-xs);
    background-color: var(--bg-raised);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
  }

  .stage-number {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    background-color: var(--accent-subtle);
    color: var(--accent);
    border: var(--border-width) solid var(--accent-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .stage-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .stage-icon {
    font-size: var(--text-sm);
    line-height: 1;
  }

  .stage-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--text);
  }

  .stage-detail {
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .stage-arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: var(--space-md);
    color: var(--border-strong);
  }

  .stage-arrow svg {
    width: 1rem;
    height: 1rem;
  }

  figcaption {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  /* ── Mobile: a deliberate vertical layout, not a squeeze. ───────────────
     Stages stack full-width and the arrow rotates to point down. */
  @media (max-width: 46rem) {
    .pipeline-track {
      flex-direction: column;
      gap: 0;
    }

    .pipeline-stage {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .stage-arrow {
      width: 100%;
      height: var(--space-md);
      transform: rotate(90deg);
    }
  }
</style>
