---
import ToolChip from './ToolChip.astro';
import { formatDateRange, isoDate } from '../lib/format';
import { weekPath } from '../lib/paths';

/**
 * One entry on the home page timeline spine.
 *
 * The whole entry is clickable, but the anchor wraps only the heading text —
 * a stretched-link pseudo-element covers the card. That keeps the accessible
 * name of the link short ("Week 5: DevOps…") instead of reading out the hook
 * and every tool chip, and it leaves the chips independently clickable.
 */
interface Props {
  week: number;
  title: string;
  hook: string;
  startDate: Date;
  endDate: Date;
  tools: string[];
  draft: boolean;
}

const { week, title, hook, startDate, endDate, tools, draft } = Astro.props;
const dateRange = formatDateRange(startDate, endDate);
---

<li class="entry">
  <span class="entry-marker" aria-hidden="true">{week}</span>

  <div class="entry-card">
    <p class="entry-meta">
      <time datetime={isoDate(startDate)}>{dateRange}</time>
      {draft && <span class="wip-badge">WIP</span>}
    </p>

    <h3 class="entry-title">
      <a href={weekPath(week)} class="entry-link">
        <span class="visually-hidden">Week {week}: </span>{title}
      </a>
    </h3>

    <p class="entry-hook">{hook}</p>

    {
      tools.length > 0 && (
        <ul class="entry-tools" aria-label={`Tools used in week ${week}`}>
          {tools.map((tool) => (
            <li>
              <ToolChip name={tool} size="sm" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
  }

  /* The spine: a line down the marker column, stopping at the last entry. */
  .entry::before {
    content: '';
    position: absolute;
    left: calc(1rem - 1px);
    top: 2rem;
    bottom: 0;
    width: 2px;
    background-color: var(--border);
  }

  .entry:last-child::before {
    display: none;
  }

  .entry-marker {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--bg-raised);
    color: var(--text-secondary);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .entry-card {
    position: relative;
    min-width: 0;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--bg-raised);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  /* Stretched link: covers the card, sits under the chips so they stay usable. */
  .entry-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .entry-tools {
    position: relative;
    z-index: 1;
  }

  .entry:hover .entry-card,
  .entry:focus-within .entry-card {
    border-color: var(--accent-border);
  }

  .entry:hover .entry-marker,
  .entry:focus-within .entry-marker {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--accent-subtle);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .wip-badge {
    padding: 0.05rem var(--space-2xs);
    background-color: var(--warning-bg);
    border: var(--border-width) solid var(--warning-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
  }

  .entry-title {
    margin-top: var(--space-3xs);
    font-size: var(--text-xl);
  }

  .entry-link {
    color: var(--text);
    text-decoration: none;
  }

  .entry-link:hover {
    color: var(--accent);
  }

  /* Focus the card, not just the text, since the whole card is the target. */
  .entry-link:focus-visible {
    outline: none;
  }

  .entry:focus-within .entry-card {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .entry-hook {
    margin-top: var(--space-3xs);
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .entry-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ── Mobile: the marker moves inline above the card so the card gets the
     full width instead of losing a 3rem column. ─────────────────────────── */
  @media (max-width: 30rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
      padding-left: var(--space-md);
      padding-bottom: var(--space-md);
    }

    .entry::before {
      left: 3px;
      top: 0.5rem;
    }

    .entry-marker {
      width: 1.5rem;
      height: 1.5rem;
      margin-left: calc(-1 * var(--space-md) - 5px);
      font-size: var(--text-xs);
    }

    .entry-card {
      padding: var(--space-xs) var(--space-sm);
    }
  }
</style>
