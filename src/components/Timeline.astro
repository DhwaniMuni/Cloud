---
import TimelineEntry from './TimelineEntry.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * The home page spine. An ordered list, because the weeks are a sequence.
 */
interface Props {
  weeks: CollectionEntry<'weeks'>[];
}

const { weeks } = Astro.props;
---

<ol class="timeline">
  {
    weeks.map((entry) => (
      <TimelineEntry
        week={entry.data.week}
        title={entry.data.title}
        hook={entry.data.hook}
        startDate={entry.data.startDate}
        endDate={entry.data.endDate}
        tools={entry.data.tools}
        draft={entry.data.draft}
      />
    ))
  }
</ol>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
